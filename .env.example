# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is git-ignored on purpose — never commit your real password.

# Your timezone, so logs/graphs show correct local time.
# Find yours: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Los_Angeles

# Password for the Pi-hole admin web UI. Pick something real; this
# protects a page that can see every device+domain on your network.
PIHOLE_PASSWORD=changeme

# Port Pi-hole's web UI is served on (http://<host-ip>:PIHOLE_WEB_PORT/admin).
# Not 80, so it doesn't collide with anything else already using port 80.
PIHOLE_WEB_PORT=8080

# --- Optional "monitor" profile (NetAlertX + Uptime Kuma) ---

# Web UI port for NetAlertX (new/unknown device alerts).
NETALERTX_WEB_PORT=20211

# Subnet + interface for NetAlertX to ARP-scan, e.g. 192.168.1.0/24/eth0
# Safe to leave blank at first — you can set this from its web UI instead.
NETALERTX_SCAN_SUBNETS=

# Port Uptime Kuma's web UI is served on.
UPTIME_KUMA_PORT=3001
